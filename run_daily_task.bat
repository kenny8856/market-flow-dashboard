@echo off
chcp 65001 >nul
title 臺股每日盤後行情與三大法人資料庫同步

echo ======================================================================
echo   臺股每日盤後行情與三大法人資料庫同步作業 (智慧接續與時間防呆)
echo   執行時間: %date% %time%
echo ======================================================================
echo.
echo 【官方發布時程與防呆備註】
echo   * 官方時程：營業日 15:30 之後由交易所與櫃買中心公布三大法人買賣超與完整行情。
echo   * 防呆機制：若當前未達 15:30，系統自動排除今日，終點設為前一營業日。
echo.

cd /d "%~dp0"
python daily_sync.py

if %ERRORLEVEL% equ 0 (
    echo.
    echo [成功] 資料庫已成功同步並儲存！
) else (
    echo.
    echo [失敗] 同步作業發生異常，錯誤代碼: %ERRORLEVEL%
)

echo.
echo ======================================================================
pause
